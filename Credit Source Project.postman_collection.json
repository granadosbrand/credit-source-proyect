  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "requests": {},
        "exec": [
          "// Skip auto-login if this IS the login request (to avoid infinite loop)",
          "if (pm.info.requestName === \"Login\" || pm.request.url.toString().includes(\"/api/auth/login\")) {",
          "    console.log(\"Skipping auto-login for the login request itself\");",
          "    return;",
          "}",
          "",
          "// Check if we already have a valid token (optional optimization)",
          "// You can remove this block if you want to login before EVERY request",
          "// const currentToken = pm.collectionVariables.get(\"access_token\");",
          "// if (currentToken) {",
          "//     console.log(\"Token already exists, using existing token\");",
          "//     // Optionally, you could add token expiration logic here",
          "//     return;",
          "// }",
          "",
          "// Perform login request",
          "const loginRequest = {",
          "    url: pm.collectionVariables.get(\"SERVICES\") + \"/api/auth/login\",",
          "    method: \"POST\",",
          "    header: {",
          "        \"Content-Type\": \"application/json\"",
          "    },",
          "    body: {",
          "        mode: \"raw\",",
          "        raw: JSON.stringify({",
          "            \"username\": \"admin\",",
          "            \"password\": \"admin\"",
          "        })",
          "    }",
          "};",
          "",
          "pm.sendRequest(loginRequest, (err, response) => {",
          "    if (err) {",
          "        console.error(\"Auto-login failed:\", err);",
          "        return;",
          "    }",
          "    ",
          "    const jsonResponse = response.json();",
          "",
          "    if (jsonResponse.access_token) {",
          "        pm.collectionVariables.set(\"access_token\", jsonResponse.access_token);",
          "        console.log(\"Auto-login successful - token updated\");",
          "    } else {",
          "        console.error(\"No access_token in login response\");",
          "    }",
          "});"
        ]
      }
    },
